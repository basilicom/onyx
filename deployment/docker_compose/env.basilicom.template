# =============================================================================
# Onyx v4 — Environment für das Basilicom-Deployment
# =============================================================================
# NICHT mit echten Secrets committen! Diese Datei ist nur die Vorlage.
# Echte Werte in Portainer -> Environment variables -> Advanced mode eintragen
# (Portainer schreibt daraus die stack.env beim Deploy).
# =============================================================================

# --- Version (PFLICHT: muss zum Repo-Tag/Branch passen) ---
IMAGE_TAG=v4.0.7

# --- Routing / Traefik ---
# Name des EXISTIERENDEN Traefik-Docker-Netzes (hier: traefik-proxy)
TRAEFIK_NETWORK=traefik-proxy
ONYX_DOMAIN=onyx.example.com
ONYX_MCP_DOMAIN=onyx-mcp.example.com
# Öffentliche URL (für OAuth-Callbacks Google Drive + CORS) — muss zur Host-Rule passen
WEB_DOMAIN=https://onyx.example.com

# --- Zugriffsschutz ---
# Die Umgebung ist öffentlich erreichbar. Schutz erfolgt über zwei Ebenen:
#  1) VPN-Allowlist (Traefik IPAllowList) — nur der VPN-Gateway darf rein.
#     Exit-IP ermitteln: im VPN `curl https://ifconfig.me` -> als CIDR (/32) hier.
VPN_SOURCE_RANGE=CHANGE_ME_vpn_exit_cidr
#     MCP zusätzlich von Anthropics Egress erreichbar (claude.ai als Remote-MCP-
#     Client). 160.79.104.0/21 ist Anthropics öffentlich publizierte Egress-Range.
#     Nur für den MCP-Router; die UI bleibt VPN-only.
ANTHROPIC_SOURCE_RANGE=160.79.104.0/21
#  2) Bearer-Token am MCP-Router (Traefik erzwingt exakt diesen Header).
#     Claude sendet: Authorization: Bearer <MCP_BEARER_TOKEN>
#     Da Anthropics Egress von allen claude.ai-Kunden geteilt wird, ist DIESER
#     Token die eigentliche Auth für den Anthropic-Pfad — stark halten.
MCP_BEARER_TOKEN=CHANGE_ME_mcp_bearer_token

# --- Auth (Onyx-App) ---
# disabled: kein Onyx-Login. Vertretbar NUR wegen VPN-Allowlist oben.
# Folge: jeder im VPN hat Vollzugriff (inkl. Admin/Connector-Settings).
# Alternative: AUTH_TYPE=basic + Onyx-Login, dann aber kein eingebauter MCP
# auf Community (API-Keys sind Business-only) -> stattdessen stdio-Bridge.
AUTH_TYPE=disabled

# --- Secrets (hier nur Platzhalter — echte Werte in Portainer!) ---
POSTGRES_PASSWORD=CHANGE_ME_postgres
# Bei AUTH_TYPE=disabled nicht zwingend, aber harmlos zu setzen.
USER_AUTH_SECRET=CHANGE_ME_user_auth_secret
# Verschlüsselt gespeicherte Connector-Credentials (Jira/Confluence/Drive-Tokens)
# at-rest. Auf einem geteilten Server UNBEDINGT setzen!
ENCRYPTION_KEY_SECRET=CHANGE_ME_encryption_key
