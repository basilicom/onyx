# =============================================================================
# Onyx v4 — Environment für das Basilicom-Deployment
# =============================================================================
# NICHT mit echten Secrets committen! Diese Datei ist nur die Vorlage.
# Echte Werte in Portainer -> Environment variables -> Advanced mode eintragen
# (Portainer schreibt daraus die stack.env beim Deploy).
# =============================================================================

# --- Version (PFLICHT: muss zum Repo-Tag/Branch passen) ---
IMAGE_TAG=v4.0.7

# --- Routing / Traefik ---
# Name des EXISTIERENDEN Traefik-Docker-Netzes (hier: traefik-proxy)
TRAEFIK_NETWORK=traefik-proxy
ONYX_DOMAIN=onyx.example.com
ONYX_MCP_DOMAIN=onyx-mcp.example.com
# Öffentliche URL (für OAuth-Callbacks Google Drive + CORS) — muss zur Host-Rule passen
WEB_DOMAIN=https://onyx.example.com

# --- Zugriffsschutz ---
# Die Umgebung ist öffentlich erreichbar. Es gibt KEINEN Netz-Filter (kein VPN/
# IP-Allowlist) davor — der Schutz ist rein anwendungsseitig:
#  - UI: Onyx-Login (AUTH_TYPE=basic). Self-Registrierung per Workspace-
#    „invite-only" + VALID_EMAIL_DOMAINS einschränken. Der erste Signup wird
#    Admin -> Admin-Konto anlegen, BEVOR die Domain öffentlich erreichbar ist.
#  - MCP: der MCP-Server validiert jeden Bearer selbst gegen /me — Claude sendet
#    einen echten Onyx-PAT (onyx_pat_...) oder API-Key (on_...), den ein Admin im
#    Onyx-UI erstellt. Der Token lebt nur in Onyx + in der Claude-MCP-Config,
#    nicht in dieser Env. Rotation in Onyx (kein Redeploy).

# --- Auth (Onyx-App) ---
# basic = Onyx-Login. Der erste Signup wird Admin; Registrierung per
# Workspace-„invite-only" + VALID_EMAIL_DOMAINS einschränken. Die UI ist
# zusätzlich durch die VPN-Allowlist geschützt.
AUTH_TYPE=basic
# Optional: Selbst-Registrierung auf eigene Domain(s) begrenzen.
# VALID_EMAIL_DOMAINS=basilicom.de

# --- Email-Versand (optional; für Signup-Verifikation + Einladungen) ---
# SMTP via STARTTLS auf Port 587 mit User/Passwort (KEIN implizites SSL/465).
# Aktiv, sobald SMTP_SERVER + SMTP_USER + SMTP_PASS gesetzt sind.
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=CHANGE_ME_smtp_user
# SMTP_PASS=CHANGE_ME_smtp_pass
# EMAIL_FROM=onyx@basilicom.de
# REQUIRE_EMAIL_VERIFICATION=true   # Signup erst nach Mail-Bestätigung
# ENABLE_EMAIL_INVITES=true         # invite-only: Einladungs-Mails versenden
# Alternative ohne eigenen SMTP-Server (HTTP-API):
# SENDGRID_API_KEY=CHANGE_ME_sendgrid_key

# --- Secrets (hier nur Platzhalter — echte Werte in Portainer!) ---
POSTGRES_PASSWORD=CHANGE_ME_postgres
# Signiert die Session-JWTs (basic auth). Stark setzen.
USER_AUTH_SECRET=CHANGE_ME_user_auth_secret
# Verschlüsselt gespeicherte Connector-Credentials (Jira/Confluence/Drive-Tokens)
# at-rest. Auf einem geteilten Server UNBEDINGT setzen!
ENCRYPTION_KEY_SECRET=CHANGE_ME_encryption_key
